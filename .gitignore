# ...but keep the small held-out real print-photo eval page + GT (thesis reproducibility)
!data/eval_real/print_photos/
!data/eval_real/print_photos/**
data/synthetic_sample/**
!data/.gitkeep
!data/real/.gitkeep
!data/synthetic/train/.gitkeep
!data/synthetic/val/.gitkeep
