# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Model checkpoints
*.pth
*.pt
*.ckpt

# Data artifacts (keep directory placeholders)
